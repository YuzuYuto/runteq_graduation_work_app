<% content_for(:title, '投稿作成') %>

<div class="container mt-4" style="max-width: 800px;">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <h1>投稿作成</h1>

      <%= form_with model: @post, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :title, 'タイトル', class: 'form-label' %>
          <%= f.text_field :title, class: 'form-control' %>
        </div>

        <div class="mb-3">
          <%= f.label :body, '本文', class: 'form-label' %>
          <%= f.text_area :body, class: 'form-control', rows: 8 %>
        </div>

        <!-- YouTube埋め込み用フィールド -->
        <div class="mb-3">
          <%= f.label :youtube_url, 'YouTube動画URL', class: 'form-label' %>
          <%= f.text_field :youtube_url, 
              class: 'form-control', 
              placeholder: 'https://youtu.be/dZ2dcC4OnQE' %>
          <div class="form-text">
            <i class="bi bi-info-circle"></i> 
            YouTube動画のURLを入力すると、投稿に埋め込まれます(任意)
          </div>
        </div>

        <div class="d-grid gap-3 col-md-6 mx-auto mt-4">
          <%= f.submit '投稿する', class: 'btn btn-primary btn-lg' %>
          <%= link_to 'キャンセル', posts_path, class: 'btn btn-secondary btn-lg' %>
        </div>
      <% end %>
    </div>
  </div>
</div>