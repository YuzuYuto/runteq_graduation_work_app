<div class="devise-container">
  <div class="devise-card">
    <h2 class="devise-title">パスワード変更</h2>
    <p class="devise-description">新しいパスワードを入力してください。</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="devise-form-group">
        <%= f.label :password, "新しいパスワード", class: "devise-label" %>
        <% if @minimum_password_length %>
          <span class="devise-hint">(<%= @minimum_password_length %>文字以上)</span>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "devise-input", placeholder: "新しいパスワードを入力" %>
      </div>

      <div class="devise-form-group">
        <%= f.label :password_confirmation, "パスワード(確認)", class: "devise-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "devise-input", placeholder: "パスワードを再入力" %>
      </div>

      <div class="devise-button-wrapper">
        <%= f.submit "更新", class: "devise-button" %>
      </div>
    <% end %>

    <div class="devise-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>